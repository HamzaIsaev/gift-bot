# ===== Секреты (файл .env никогда не коммитится) =====
# Токен управляющего бота от @BotFather
BOT_TOKEN=
# Ваш Telegram id (можно несколько: [111,222]); узнать — @userinfobot
ADMIN_IDS=[732020026]
# Telegram-аккаунт для входа на площадки (лучше отдельный): my.telegram.org -> API development tools
TG_API_ID=
TG_API_HASH=
# Строка сессии — получить: python scripts/login.py
TG_SESSION_STRING=
# Необязательно: initData Tonnel из браузера, если автоматический вход не сработает
# TONNEL_AUTH_DATA=
# Необязательно: прокси для запросов к площадкам
# MARKETS_PROXY=http://user:pass@host:port

# ===== Общее =====
TIMEZONE=Europe/Moscow
ENABLED_MARKETS=["portals","tonnel","mrkt"]
POLL_INTERVAL_SEC=6
VIRTUAL_BALANCE_TON=100

# ===== Комиссии (доли; ПРОВЕРИТЬ в мини-приложениях) =====
FEES_PORTALS={"buy":0.0,"sell":0.05}
FEES_TONNEL={"buy":0.10,"sell":0.0}
FEES_MRKT={"buy":0.0,"sell":0.0}
NETWORK_FEE_TON=0.05
TRANSFER_COST_TON=0.5

# ===== Стратегия =====
MIN_PROFIT_PCT=12
UNDERCUT_PCT=1
SALES_WINDOW_DAYS=7
REPRICE_AFTER_HOURS=6
REPRICE_STEP_PCT=3
ADAPTIVE=true

# ===== Лимиты по умолчанию (дальше меняются через /limits) =====
MAX_TRADE_TON=20
MAX_DAILY_LOSS_TON=30
MAX_OPEN_POSITIONS=5

# ===== Админ-панель =====
# На этом компьютере: http://localhost:8080. На сервере: PANEL_HOST=0.0.0.0 и обязательно PANEL_PASSWORD
PANEL_ENABLED=true
PANEL_PORT=8080
# PANEL_HOST=127.0.0.1
# PANEL_PASSWORD=

# ===== Отчёт =====
REPORT_WEEKDAY=mon
REPORT_HOUR=9
